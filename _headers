# NOT USED ON GITHUB PAGES. This file only does something on hosts that read a
# _headers file (Cloudflare Pages, Netlify). GitHub Pages cannot set response headers,
# so the deploy workflow does not publish this file; the site relies on the <meta>
# equivalents already in index.html (CSP, referrer policy, frame-busting script).
# If you put Cloudflare in front of GitHub Pages, copy these values into
# Cloudflare -> Rules -> Transform Rules -> Modify Response Header.
#
# KEEP the Content-Security-Policy in sync with the <meta http-equiv> tag in
# index.html (a test checks this).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; frame-ancestors 'none';

# long-lived caching for files that never change name
/media/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# these change whenever you publish
/data.js
  Cache-Control: no-cache
/feed.xml
  Cache-Control: no-cache
/sitemap.xml
  Cache-Control: no-cache
